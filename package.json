{
  "name": "SucSeed",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "biome check --write"
    ],
    "**/*.rb": [
      "bundle exec rubocop -a --force-exclusion"
    ],
    "Gemfile.lock": [
      "bin/check_lockfile_platforms"
    ]
  },
  "scripts": {
    "build": "esbuild frontend/application.ts --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --loader:.tsx=tsx --loader:.ts=ts",
    "build:watch": "pnpm build --watch=forever",
    "build:css": "tailwindcss -i ./frontend/styles/tailwind.css -o ./app/assets/builds/tailwind.css --minify",
    "build:css:watch": "tailwindcss -i ./frontend/styles/tailwind.css -o ./app/assets/builds/tailwind.css --watch=always",
    "lint": "biome check frontend/",
    "lint:fix": "biome check --write frontend/",
    "format": "biome format --write frontend/",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/react": "^10.62.0",
    "@tailwindcss/cli": "^4.2.1",
    "lucide-react": "^1.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "three": "^0.183.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@parcel/watcher",
      "@tailwindcss/cli",
      "esbuild"
    ]
  }
}
