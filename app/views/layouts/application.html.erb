<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>SucSeed</title>
    <%= favicon_link_tag "logo.png" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="sentry-dsn" content="<%= ENV.fetch('SENTRY_DSN', '') %>">
    <meta name="rails-env" content="<%= Rails.env %>">
    <%# Tailwind CSS（@tailwindcss/cli が app/assets/builds/tailwind.css を生成） %>
    <%= stylesheet_link_tag "tailwind", media: 'all' %>
    <%# esbuild が app/assets/builds/application.js を生成する。type: module が必要 %>
    <%= javascript_include_tag "application", type: "module" %>
  </head>

  <body>
  <% is_admin_page = controller_name.in?(["admin", "admin_edit"]) %>
  <!-- Login Modal (React island: packages/ui/layout/LoginModal.tsx) -->
  <div id="spa-login-modal"></div>
  <!-- Next の画面で積んだ flash (React island: packages/ui/components/PendingFlash.tsx) -->
  <div id="spa-flash"></div>
  <% unless is_admin_page %>
    <header>
      <%# Navbar (React island: packages/ui/layout/Navbar.tsx) %>
      <div id="spa-navbar"></div>
    </header>
  <% end %>
    <div class="w-full">
      <%= yield %>
    </div>

    <% unless is_admin_page %>
    <!-- ログイン時のスペーサー (React island: islands.tsx が role に応じて class を付与) -->
    <div id="spa-margin-box"></div>
    <!-- Footer (React island: packages/ui/layout/Footer.tsx) -->
    <div id="spa-footer"></div>
    <% end %>
  </body>
</html>
